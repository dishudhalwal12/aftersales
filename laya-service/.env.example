# laya-service — copy to `.env` and fill in. Nothing here is required to start the
# service: without a secret it still answers /health and refuses inference on purpose.

# Where uvicorn binds. Loopback by default; the Next.js backend reaches it locally, or
# through the same kind of tunnel the Baileys bridge uses when the site is deployed.
LAYA_HOST=127.0.0.1
LAYA_PORT=8100

# Shared secret the backend sends as `x-laya-secret`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be exactly the value of LAYA_SERVICE_SECRET in the app's .env.
LAYA_SERVICE_SECRET=

# Hugging Face checkpoint. The default is the typed-decisions MLX conversion this
# service is built for; point it at a local path to run offline after the first pull.
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx

# Guard rails. The app caps an inbound message at 4 000 characters, so this matches it.
LAYA_MAX_MESSAGE_CHARS=4000
# How long a request waits for a checkpoint that is still loading before answering 503.
LAYA_READY_TIMEOUT_SECONDS=15
