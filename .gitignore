# ─── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output & caches ─────────────────────────────────────────────────
# Root-anchored on purpose: the mirrored landing page ships its own
# `assets/wp/js/dist/` and `assets/theme/css/`, which must stay in the repo.
/.next/
/out/
/dist/
/build/
/coverage/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# ─── Local data ────────────────────────────────────────────────────────────
prisma/*.db
prisma/*.db-journal

# ─── Secrets — `.env.example` is the only env file that may be committed ───
.env
.env.*
!.env.example

# ─── Agent and editor tooling ─────────────────────────────────────────────
# These are local workflow files, not part of the product.
AGENTS.md
.pi/
.claude/
.superpowers/
.thinkrail/
.DS_Store
Thumbs.db
.idea/
*.swp
*.log

# ─── Python caches (Laya has its own .gitignore; this covers the root) ─────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ─── One-off design generators and downloaded reference material ───────────
docs/superpowers/
docs/design/screens/build_aftersales_ui.py
landingpage.it/
inspiration.webp
.vercel
.env.local
.env.production.local
