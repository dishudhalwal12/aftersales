# ─── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output & caches ─────────────────────────────────────────────────
# Root-anchored on purpose: the mirrored landing page ships its own
# `assets/wp/js/dist/` and `assets/theme/css/`, which must stay in the repo.
/.next/
/out/
/dist/
/build/
/coverage/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# ─── Local data ────────────────────────────────────────────────────────────
prisma/*.db
prisma/*.db-journal

# ─── Secrets — `.env.example` is the only env file that may be committed ───
.env
.env.*
!.env.example

# ─── Tooling, editors, OS noise ────────────────────────────────────────────
.thinkrail/
.pi/git/
.DS_Store
Thumbs.db
.idea/
*.swp
*.log

# ─── Reference material (downloaded, never shipped) ────────────────────────
landingpage.it/
.vercel
.env.local
.env.production.local
