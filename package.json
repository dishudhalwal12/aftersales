{
  "name": "aftersales-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Team 41 - SPHINX '26 PS 2.5 omnichannel AI support & triage",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/setup.mjs --deps --quiet",
    "dev": "node scripts/stack.mjs",
    "dev:web": "next dev",
    "dev:services": "node scripts/stack.mjs --services-only",
    "setup": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "verify:phase1": "node --env-file-if-exists=.env scripts/verify-phase1.mjs",
    "verify:phase3": "node --env-file-if-exists=.env scripts/verify-phase3.mjs",
    "typecheck": "tsc --noEmit",
    "verify:hydration": "node scripts/verify-hydration.mjs",
    "landing": "node scripts/serve-landing.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "verify:phase4": "node --env-file-if-exists=.env scripts/verify-phase4.mjs",
    "env:check": "node --env-file-if-exists=.env scripts/check-env.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prisma": "6.19.3",
    "typescript": "^7.0.2"
  }
}
