// Prisma schema — PRD rev 4 §3, plus one additive column noted inline.
// Postgres on Supabase. `url` goes through the connection pooler (port 6543)
// because serverless functions open a connection per invocation; `directUrl`
// is the session-pooler connection (port 5432) that `prisma db push` /
// `migrate` must use, since transaction mode cannot run DDL. It is a pooler
// host, not db.<ref>.supabase.co, which is IPv6-only without the IPv4 add-on.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  googleId     String?
  createdAt    DateTime   @default(now())
  businesses   Business[]
}

model Business {
  id               String              @id @default(cuid())
  ownerId          String
  owner            User                @relation(fields: [ownerId], references: [id])
  name             String
  businessType     String
  description      String
  productsServices String
  hours            String
  returnPolicy     String
  faqs             String
  escalationEmail  String
  escalationPhone  String
  agentTone        String              @default("Warm, concise, and helpful")
  autoSendEnabled  Boolean             @default(true)
  compiledBrainMd  String
  brainVersion     Int                 @default(1)
  // ADDITIVE (not in PRD §3): the wizard's .md upload is a first-class input,
  // so it is persisted instead of being silently folded into another column.
  rawMarkdownUpload String              @default("")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  chunks           KnowledgeChunk[]
  channels         ChannelConnection[]
  tickets          Ticket[]
  voiceSessions    VoiceTestSession[]
  voiceAgentContext BusinessVoiceAgentContext?
  voiceCustomizations BusinessVoiceAgentCustomization[]
}

/**
 * Extra context the voice agent needs but the business brain does not carry
 * (the brain is a retrieval corpus, not a call script). One row per business;
 * `virtualNumber` / `agentId` are the trusted identifiers that map an inbound
 * call back to its tenant. They are not unique at the DB level because the
 * resolver must be able to *detect* an ambiguous mapping and refuse the call
 * rather than silently pick one tenant.
 */
model BusinessVoiceAgentContext {
  businessId         String   @id
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessAddress    String   @default("")
  // JSON string array of weekday names, e.g. ["Sunday"].
  weeklyHolidays     String   @default("[]")
  // JSON string array of language labels, e.g. ["Hindi","English"].
  supportedLanguages String   @default("[]")
  appointmentPolicy  String   @default("")
  agentInstructions  String   @default("")
  virtualNumber      String?
  agentId            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([virtualNumber])
  @@index([agentId])
}

/**
 * Category-specific behaviour the voice agent must follow (availability,
 * booking rules, policies, call handling). One row per type rather than a
 * column per feature, so a new customization type needs no DDL. The JSON is
 * validated in `src/server/voice/customizations.ts` before it is stored.
 */
model BusinessVoiceAgentCustomization {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customizationType String
  configuration     String   @default("{}")
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([businessId, customizationType])
  @@index([businessId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunkIndex Int
  section    String
  content    String
  keywords   String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model ChannelConnection {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channelType String
  status      String
  autoSend    Boolean  @default(false)
  configJson  String?
  updatedAt   DateTime @updatedAt

  @@unique([businessId, channelType])
}

model Ticket {
  id                 String        @id @default(cuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Provider message ids are tenant-scoped: a global unique key lets one tenant's replay read
  // another tenant's ticket (AT-05). Idempotency is the pair, never the raw id alone.
  externalMessageId  String?
  channel            String
  customerName       String
  customerHandle     String
  customerQuery      String
  state              String
  specialistAssigned String
  intent             String
  sentiment          String
  urgencyScore       Int
  confidenceScore    Int
  actionStatus       String
  routingRuleHit     String
  aiDraftOrReply     String
  citedChunkIds      String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  events             TicketEvent[]

  @@index([businessId, state])
  @@index([businessId, createdAt])
  @@unique([businessId, externalMessageId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventType String
  payload   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model VoiceTestSession {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  demoPin             String
  judgePhone          String
  status              String
  sarvamInteractionId String?
  transcript          String?
  durationSeconds     Int?
  escalationOutcome   String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([businessId])
  @@index([judgePhone, status])
}
