# AfterSales AI — Team 41 (SPHINX '26 PS 2.5)
# Every key this app reads is listed here with an empty value. Never commit real values.
# Copy to `.env` and fill only what you have: every key has a truthful degraded path.

DATABASE_URL="file:./dev.db"

# Signs the session cookie. Required in production (the app refuses to boot without it).
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# LLM provider: "openrouter" | "heuristic".
#   openrouter — needs OPENROUTER_API_KEY. A missing key or a failed call becomes Rule R7.
#   heuristic  — no network, no key: retrieval-scored classifier. The UI labels it degraded.
# Unset with no API key falls back to "heuristic" and says so on screen.
LLM_PROVIDER=""
OPENROUTER_API_KEY=""
LLM_MODEL_ID="meta-llama/llama-3.3-70b-instruct"

# Google OAuth (optional; the button reports itself unavailable when these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase — used ONLY as the Google OAuth broker. A signed Google identity is
# mapped onto a Prisma user and the app's own AUTH_SECRET cookie session is
# started, so these two keys are the whole integration.
# Empty values are valid: the Google button then reports itself unconfigured.
# The anon key is public by design; a service_role key must never appear here.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Sarvam AI voice. Empty keys keep the voice panel in an honest test mode.
SARVAM_API_KEY=""
SARVAM_AGENT_ID=""
SARVAM_VIRTUAL_NUMBER=""
PUBLIC_WEBHOOK_BASE_URL=""
