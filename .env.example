# AfterSales AI — Team 41 (SPHINX '26 PS 2.5)
# Every key this app reads is listed here with an empty value. Never commit real values.
# Copy to `.env` and fill only what you have: every key has a truthful degraded path.

# ---------------------------------------------------------------------------
# Local Postgres (fastest path on a dev machine; keeps provider = "postgresql")
#   createdb aftersales && npx prisma db push && npm run db:seed
# Both variables point at the same local database on purpose: DIRECT_URL is the
# connection `prisma db push` / migrate runs DDL on, so it must not be a
# transaction pooler. Comment this block out and use the Supabase block below
# when the app is deployed.
# DATABASE_URL="postgresql://<you>@localhost:5432/aftersales?schema=public"
# DIRECT_URL="postgresql://<you>@localhost:5432/aftersales?schema=public"

# Supabase Postgres. Copy both strings from Project Settings -> Database.
#   DATABASE_URL — "Transaction pooler" (port 6543), add ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   — "Session pooler" (port 5432); used by `prisma db push` / migrate.
#                  Not the "Direct connection" host: db.<ref>.supabase.co is IPv6-only
#                  unless the project has the IPv4 add-on, and Vercel is IPv4.
# The password is the database password, never the anon key.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Signs the session cookie. Required in production (the app refuses to boot without it).
# NEXTAUTH_SECRET is only a legacy fallback read when AUTH_SECRET is empty.
AUTH_SECRET=""
# The app's public origin, used to build the Google OAuth `redirect_to`.
#   - A deployed host must set AUTH_BASE_URL (or a non-local NEXTAUTH_URL) if it is not Vercel.
#   - On Vercel you can leave both empty: VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are read
#     automatically, so production never redirects a browser to localhost.
#   - A local value is honoured locally and only used in production as a last resort.
AUTH_BASE_URL=""
NEXTAUTH_URL="http://localhost:3000"

# The "1-click judge demo login" door on /auth. Open by default; set to "off" to close it
# (the route then answers 404). It only ever signs in the published demo account.
JUDGE_DEMO_LOGIN=""

# LLM provider: "openrouter" | "heuristic".
#   openrouter — needs OPENROUTER_API_KEY. A missing key or a failed call becomes Rule R7.
#   heuristic  — no network, no key: retrieval-scored classifier. The UI labels it degraded.
# Unset with no API key falls back to "heuristic" and says so on screen.
LLM_PROVIDER=""
OPENROUTER_API_KEY=""
LLM_MODEL_ID="meta-llama/llama-3.3-70b-instruct"

# Supabase — used ONLY as the Google OAuth broker. Empty values are valid: the
# Google button then reports itself unconfigured instead of failing silently.
# Unprefixed on purpose: Vercel rejects `visibility: secret` on a NEXT_PUBLIC_*
# name because those are inlined into the browser bundle at build time, and
# neither value is ever read by the browser. The NEXT_PUBLIC_SUPABASE_* names
# are still accepted as a fallback.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# The Google client id/secret do NOT belong here: they are entered in the
# Supabase dashboard (Authentication -> Providers -> Google), so this app never
# reads them.

# Sarvam AI voice.
# SARVAM_CALL_ENDPOINT is the outbound-call URL from your Sarvam account — it is
# configuration, not a hardcoded guess. Without both keys the voice panel is a dry
# run: session, PIN, retrieval and ticket write-back are real, the dial is not.
SARVAM_API_KEY=""
SARVAM_AGENT_ID=""
SARVAM_VIRTUAL_NUMBER=""
SARVAM_CALL_ENDPOINT=""
# Shared secret the voice platform sends as `x-sarvam-token` on completion webhooks.
SARVAM_WEBHOOK_TOKEN=""
PUBLIC_WEBHOOK_BASE_URL=""

# Shared secret a channel adapter sends as `x-channel-token` on inbound webhooks.
# Set = a provider may POST /api/channels/webhook/[provider] without the owner's session.
# Empty = only the signed-in owner (the dashboard simulator) may deliver.
CHANNEL_WEBHOOK_SECRET=""

# ─── Connected accounts: Email, Meta, WhatsApp ─────────────────────────────
# These back Dashboard -> Channels -> Connected accounts. Each card reports
# itself as unavailable (and says why) until its variables are set, so leaving
# this block empty is a truthful state, not a broken one.

# Encrypts provider tokens (Gmail refresh/access tokens, Meta Page token)
# before they are written to ChannelConnection.configJson. Exactly 32 bytes,
# base64 or 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = connect/disconnect answer 503 and status reports encryptionConfigured=false.
INTEGRATION_ENCRYPTION_KEY=""

# Signs the OAuth `state` for Gmail and Meta (HMAC-SHA256, 10-minute TTL) so a
# callback cannot be replayed or moved to another tenant. Falls back to
# AUTH_SECRET, then NEXTAUTH_SECRET, when empty.
INTEGRATION_STATE_SECRET=""

# Public origin of this app, used to build OAuth redirect URIs. Set it to the
# deployed URL (or a tunnel URL while testing locally) and register the same
# callback in Google Cloud / Meta:
#   <origin>/api/social/email/callback
#   <origin>/api/social/meta/callback
# Empty = the incoming request origin is used.
INTEGRATIONS_BASE_URL=""

# Optional: where an OAuth callback sends the browser after connecting.
# Empty = the callback returns JSON (handy for curl and tests).
INTEGRATIONS_FRONTEND_REDIRECT_URL=""

# Email (Gmail API, OAuth only — the owner never types a mailbox password).
# EMAIL_PROVIDER currently supports "gmail". The GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET names are accepted as fallbacks.
# Incoming mail is polled because Gmail push requires Google Cloud Pub/Sub.
EMAIL_PROVIDER="gmail"
EMAIL_GMAIL_CLIENT_ID=""
EMAIL_GMAIL_CLIENT_SECRET=""

# Authenticates GET /api/social/email/poll. Vercel Cron sends
# `Authorization: Bearer <CRON_SECRET>`; a local scheduler may send
# `x-cron-secret`. Unset = scheduled polling answers 503 and stays off.
CRON_SECRET=""

# Meta (Facebook Login for Pages + linked Instagram professional accounts).
# Meta only grants these scopes to apps that have completed App Review for
# them: pages_show_list, pages_messaging, pages_manage_metadata,
# instagram_basic, instagram_manage_messages.
META_APP_ID=""
META_APP_SECRET=""
# Optional Graph API version override; defaults to v26.0.
META_GRAPH_VERSION=""
# Echoed back on Meta's GET webhook handshake (hub.verify_token).
META_WEBHOOK_VERIFY_TOKEN=""

# Local Baileys WhatsApp service — see baileys-service/README.md and docs/ENV-SETUP.md.
# Run it on this machine and point the URL at http://localhost:3001; a tunnel is
# only needed when this app is deployed. The backend calls it with
# `x-baileys-secret`; the service calls back to /api/channels/whatsapp/inbound and
# .../status with the same secret. Unset = the WhatsApp card is unavailable.
BAILEYS_SERVICE_URL=""
BAILEYS_SERVICE_SECRET=""
# Optional HTTP timeout for service calls; default 15000 ms, capped at 60000 ms.
BAILEYS_TIMEOUT_MS=""

# Local Laya typed-decision service — see laya-service/README.md for how to run it
# (Apple silicon only: the checkpoint is MLX). Advisory: it adds the per-ticket
# decision sheet (urgent / not urgent, intent, frustration, …) and never reaches a
# routing rule. The backend calls it with `x-laya-secret`. Unset = tickets carry no
# decision sheet and say so.
LAYA_SERVICE_URL=""
LAYA_SERVICE_SECRET=""
# Optional HTTP timeout for decision calls; default 4000 ms, capped at 30000 ms.
LAYA_TIMEOUT_MS=""

# Port for the static landing replica (`npm run landing`). Defaults to 8080.
LANDING_PORT=""
