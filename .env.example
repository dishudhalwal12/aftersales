# ---------------------------------------------------------------------------
# Database (SQLite by default; swap the provider in prisma/schema.prisma for
# PostgreSQL and point this at the connection string.)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# AUTH_SECRET is the Auth.js v5 canonical name; NEXTAUTH_SECRET is kept for
# compatibility with the PRD. Set BOTH to the same value.
# ---------------------------------------------------------------------------
AUTH_SECRET="hackathon-super-secret-key-team-41"
NEXTAUTH_SECRET="hackathon-super-secret-key-team-41"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# 1-Click Judge Demo Login account (created on demand if missing)
DEMO_USER_EMAIL="judge@sphinx.demo"

# ---------------------------------------------------------------------------
# LLM Provider (OpenRouter / OpenAI compatible) — used from Phase 2 onward
# ---------------------------------------------------------------------------
# Leave OPENROUTER_API_KEY blank to run the full app in fail-safe mode:
# triage still logs every ticket and escalates it (rule R7) without auto-sending.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL_ID="meta-llama/llama-3.3-70b-instruct"
LLM_TIMEOUT_MS="20000"

# ---------------------------------------------------------------------------
# Google OAuth (optional; the Google button is hidden/unavailable when blank)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Sarvam AI Voice (Phase 4)
# ---------------------------------------------------------------------------
# Outbound calls need SARVAM_API_KEY + SARVAM_AGENT_ID. Without them
# /api/voice/start-session still records the session, marks it failed, and
# answers 503 SARVAM_NOT_CONFIGURED. The three grounding routes below work
# independently of the provider, so the demo can be exercised with curl/tests.
SARVAM_API_KEY=""
SARVAM_AGENT_ID=""
SARVAM_VIRTUAL_NUMBER="+91XXXXXXXXXX"
# Optional overrides — defaults are https://api.sarvam.ai + /v1/voice-agents/calls
SARVAM_API_BASE_URL=""
SARVAM_OUTBOUND_PATH=""
SARVAM_TIMEOUT_MS="15000"

# Shared secrets (constant-time compared, SHA-256 hashed in memory only).
# SARVAM_TOOL_SECRET guards /api/voice/sarvam-tool-search (sent by Sarvam as
# x-sarvam-tool-secret). SARVAM_WEBHOOK_SECRET guards
# /api/voice/sarvam-webhook (x-sarvam-webhook-secret). Unset = the route
# answers 503 SARVAM_NOT_CONFIGURED instead of running unauthenticated.
SARVAM_TOOL_SECRET=""
SARVAM_WEBHOOK_SECRET=""

# Public base URL Sarvam can reach (ngrok/tunnel). Used by the health check to
# hint whether voice callbacks are reachable.
PUBLIC_WEBHOOK_BASE_URL=""

# ---------------------------------------------------------------------------
# Local WhatsApp service (Baileys) — runs separately from this Next.js app
# ---------------------------------------------------------------------------
# BAILEYS_SERVICE_URL is where the Next.js backend reaches the local service.
# Use http://localhost:3001 for local development; on a Vercel deployment use
# the public tunnel URL instead (for example https://your-tunnel.example.com).
# The service must also be able to reach this Next.js app's public URL to post
# inbound messages and status events (see baileys-service/.env.example).
# BAILEYS_SERVICE_SECRET must match the service's BAILEYS_SERVICE_SECRET and
# must never be exposed to the frontend. Unset = WhatsApp routes answer
# 503 BAILEYS_NOT_CONFIGURED.
BAILEYS_SERVICE_URL="http://localhost:3001"
BAILEYS_SERVICE_SECRET=""
# Must exceed the service's CONNECT_WAIT_MS (default 10s) so /connect can answer.
BAILEYS_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Email + Meta integrations (business owner onboarding)
# ---------------------------------------------------------------------------
# INTEGRATIONS_BASE_URL is the public backend URL used to build OAuth redirect
# URIs. It must match the URI registered with the provider exactly. Locally the
# request origin is used when this is blank, but set it in production.
INTEGRATIONS_BASE_URL="http://localhost:3000"
# Optional: send the browser back to a frontend page after an OAuth callback
# with ?integration=&status=&businessId=. Blank returns JSON instead.
INTEGRATIONS_FRONTEND_REDIRECT_URL=""

# Encrypts provider tokens at rest (AES-256-GCM). 32 random bytes as base64 or
# 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value makes existing connections unreadable; owners must
# reconnect. Required for Email and Meta; never commit the real value.
INTEGRATION_ENCRYPTION_KEY=""
# HMAC key for short-lived OAuth state. Falls back to AUTH_SECRET when blank.
INTEGRATION_STATE_SECRET=""

# Email provider. Only "gmail" is implemented; the routes reject others instead
# of pretending an API-key provider exists.
EMAIL_PROVIDER="gmail"
# Gmail OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Falls back to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET when blank. Use a
# separate OAuth client if the Auth.js sign-in client does not have the Gmail
# API enabled. Google requires the redirect URI
# {INTEGRATIONS_BASE_URL}/api/social/email/callback.
EMAIL_GMAIL_CLIENT_ID=""
EMAIL_GMAIL_CLIENT_SECRET=""

# Shared secret for GET /api/social/email/poll. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Unset disables polling.
CRON_SECRET=""

# Meta developer app (developers.facebook.com). The redirect URI registered on
# the Facebook Login product must be
# {INTEGRATIONS_BASE_URL}/api/social/meta/callback. The webhook callback is
# {INTEGRATIONS_BASE_URL}/api/social/meta/webhook.
META_APP_ID=""
META_APP_SECRET=""
# Graph API version used for OAuth and messaging calls.
META_GRAPH_VERSION="v26.0"
# Paste the same token into the Meta app dashboard's webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=""
