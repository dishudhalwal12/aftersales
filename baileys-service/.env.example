# ---------------------------------------------------------------------------
# Local Baileys WhatsApp service — copy to .env and fill in.
# Never commit the real .env or the sessions/ folder.
# ---------------------------------------------------------------------------

# Port the local HTTP API listens on. The Vercel backend reaches this through
# the tunnel, never through localhost.
PORT=3001

# Shared secret between the Vercel backend and this service (both directions).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical to BAILEYS_SERVICE_SECRET in the Vercel environment.
BAILEYS_SERVICE_SECRET=replace-with-a-long-random-secret

# Base URL of the deployed Vercel backend. Only used to derive the webhook URL
# below when VERCEL_WEBHOOK_URL is not set.
VERCEL_BACKEND_URL=https://your-app.vercel.app

# Full URL that incoming WhatsApp messages are POSTed to. Defaults to
# ${VERCEL_BACKEND_URL}/api/channels/whatsapp/inbound
VERCEL_WEBHOOK_URL=

# Full URL for connection status updates. Defaults to
# ${VERCEL_BACKEND_URL}/api/channels/whatsapp/status
VERCEL_STATUS_WEBHOOK_URL=

# Where per-connection Baileys credentials are stored on this laptop.
# One sub-folder per connectionId. Add this folder to backups if you want the
# session to survive a machine reset (it is equivalent to a password).
SESSION_STORAGE_PATH=./sessions

# How long POST /connect waits for the first QR code or connection before
# replying (milliseconds).
CONNECT_WAIT_MS=10000

# Timeout for each webhook delivery attempt (milliseconds).
WEBHOOK_TIMEOUT_MS=10000

# Maximum delay between reconnect attempts (milliseconds).
RECONNECT_MAX_DELAY_MS=30000

# debug | info | warn | error
LOG_LEVEL=info
